<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_page">

    <!-- STEP 1 and 2: GREEN SEARCH HEADER -->
    <LinearLayout
        android:id="@+id/llSearchHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1D9E75"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="44dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="10dp">

            <TextView
                android:id="@+id/btnBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="← Back"
                android:textSize="13sp"
                android:textColor="#CCffffff"
                android:paddingEnd="10dp"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:id="@+id/tvStepTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Where to?"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"/>
        </LinearLayout>

        <!-- Destination search input -->
        <LinearLayout
            android:id="@+id/llDestContainer"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:background="@drawable/bg_search_input"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="4dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_search"
                android:layout_marginEnd="8dp"/>

            <EditText
                android:id="@+id/etSearchLocation"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:hint="MG Road, Bengaluru..."
                android:textColor="#FFFFFF"
                android:textColorHint="#99ffffff"
                android:textSize="13sp"
                android:background="@android:color/transparent"
                android:singleLine="true"
                android:imeOptions="actionSearch"/>

            <ImageButton
                android:id="@+id/btnSearch"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_search"
                android:background="@android:color/transparent"/>
        </LinearLayout>

        <!-- Live suggestions dropdown -->
        <LinearLayout
            android:id="@+id/llSuggestions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_dark_card"
            android:layout_marginTop="6dp"
            android:visibility="gone"/>

    </LinearLayout>

    <!-- STEP 2: PICKUP SHEET -->
    <LinearLayout
        android:id="@+id/llPickupContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#162534"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="6dp"
        android:paddingBottom="10dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/btnBack2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="← Back"
                android:textSize="13sp"
                android:textColor="#1D9E75"
                android:paddingEnd="10dp"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Set Pickup"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"/>
        </LinearLayout>

        <!-- Option 1: Current location -->
        <LinearLayout
            android:id="@+id/btnPickupCurrent"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_pickup_option"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:layout_marginBottom="8dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_my_location"
                android:layout_marginEnd="12dp"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Use current location"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GPS — your position now"
                    android:textSize="10sp"
                    android:textColor="@color/text_secondary"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Option 2: Type custom address -->
        <LinearLayout
            android:id="@+id/llCustomPickup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pickup_option"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:layout_marginBottom="10dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_place"
                android:layout_marginEnd="12dp"/>

            <EditText
                android:id="@+id/etPickupLocation"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:hint="Enter custom address..."
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"
                android:textSize="13sp"
                android:background="@android:color/transparent"
                android:singleLine="true"/>

            <Button
                android:id="@+id/btnConfirmPickup"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Set"
                android:textSize="11sp"
                android:backgroundTint="#1D9E75"
                android:textColor="@color/bg_page"/>
        </LinearLayout>

    </LinearLayout>

    <!-- MAP FILLS REMAINING SPACE -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <org.osmdroid.views.MapView
            android:id="@+id/mapView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>

        <!-- Status banner on top of map -->
        <LinearLayout
            android:id="@+id/arrivalBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:layout_margin="12dp"
            android:background="@drawable/bg_arrival_banner"
            android:padding="12dp"
            android:gravity="center_vertical"
            android:visibility="gone">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_local_taxi"
                android:layout_marginEnd="8dp"/>

            <TextView
                android:id="@+id/tvArrivalAlert"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Searching for drivers..."
                android:textColor="#5DCAA5"
                android:textStyle="bold"
                android:textSize="13sp"/>
        </LinearLayout>

    </FrameLayout>

    <!-- STEP 3: VEHICLE SELECTION PANEL -->
    <LinearLayout
        android:id="@+id/llVehiclePanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#162534"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:visibility="gone">

        <!-- Route summary -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:layout_marginBottom="4dp">

            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/bg_circle_green"
                android:layout_marginEnd="6dp"/>

            <TextView
                android:id="@+id/tvFromLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Current location"
                android:textSize="10sp"
                android:textColor="@color/text_secondary"
                android:singleLine="true"/>

            <View
                android:layout_width="20dp"
                android:layout_height="1dp"
                android:background="#2a3a4a"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"/>

            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/bg_route_icon_amber"
                android:layout_marginEnd="6dp"/>

            <TextView
                android:id="@+id/tvToLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Destination"
                android:textSize="10sp"
                android:textColor="@color/text_secondary"
                android:singleLine="true"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tvDistanceLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginBottom="8dp"
            android:text="-- km · ₹20 per km"
            android:textSize="10sp"
            android:textColor="@color/text_muted"/>

        <!-- AUTO card -->
        <LinearLayout
            android:id="@+id/btnSelectAuto"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_ride_card_selected"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="6dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_local_taxi"
                android:layout_marginEnd="12dp"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Auto Rickshaw"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"/>

                <TextView
                    android:id="@+id/tvAutoEta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ETA 4 min"
                    android:textSize="10sp"
                    android:textColor="@color/text_secondary"/>
            </LinearLayout>

            <TextView
                android:id="@+id/tvAutoPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹--"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#1D9E75"/>
        </LinearLayout>

        <!-- CAB card -->
        <LinearLayout
            android:id="@+id/btnSelectCab"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_ride_card_normal"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="6dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_directions_car"
                android:layout_marginEnd="12dp"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cab"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"/>

                <TextView
                    android:id="@+id/tvCabEta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ETA 6 min"
                    android:textSize="10sp"
                    android:textColor="@color/text_secondary"/>
            </LinearLayout>

            <TextView
                android:id="@+id/tvCabPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹--"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_secondary"/>
        </LinearLayout>

        <!-- BIKE card -->
        <LinearLayout
            android:id="@+id/btnSelectBike"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_ride_card_normal"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="8dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_two_wheeler"
                android:layout_marginEnd="12dp"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bike"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"/>

                <TextView
                    android:id="@+id/tvBikeEta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ETA 3 min"
                    android:textSize="10sp"
                    android:textColor="@color/text_secondary"/>
            </LinearLayout>

            <TextView
                android:id="@+id/tvBikePrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹--"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_secondary"/>
        </LinearLayout>

        <!-- BOOK button -->
        <Button
            android:id="@+id/btnBookRide"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:text="Book Auto — ₹--"
            android:textAllCaps="false"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#1D9E75"/>

        <TextView
            android:id="@+id/btnReset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Reset"
            android:textColor="@color/text_muted"
            android:layout_gravity="center"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true"/>

    </LinearLayout>

</LinearLayout>
