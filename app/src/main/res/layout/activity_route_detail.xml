<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/bg_page">

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:scrollbars="none">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingStart="18dp"
            android:paddingEnd="18dp" android:paddingTop="52dp" android:paddingBottom="16dp">

            <!-- Back -->
            <TextView android:id="@+id/btnBack"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="← Back" android:textSize="14sp" android:textColor="#1D9E75"
                android:layout_marginBottom="16dp"/>

            <!-- Route name -->
            <TextView android:id="@+id/tvRouteName"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Route 1" android:textSize="26sp" android:textStyle="bold"
                android:textColor="@color/text_primary" android:layout_marginBottom="4dp"/>

            <TextView android:id="@+id/tvRouteFromTo"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Town Center → Railway Station"
                android:textSize="13sp" android:textColor="@color/text_secondary"
                android:layout_marginBottom="20dp"/>

            <!-- 4-stat row -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:baselineAligned="false"
                android:layout_marginBottom="20dp">

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical"
                    android:gravity="center" android:background="@drawable/bg_stat_dark"
                    android:padding="10dp" android:layout_marginEnd="6dp">
                    <TextView android:id="@+id/tvDetailStops"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="5" android:textSize="22sp" android:textStyle="bold"
                        android:textColor="#1D9E75"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Stops" android:textSize="9sp" android:textColor="@color/text_secondary"/>
                </LinearLayout>

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical"
                    android:gravity="center" android:background="@drawable/bg_stat_dark"
                    android:padding="10dp" android:layout_marginEnd="6dp">
                    <TextView android:id="@+id/tvDetailDistance"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="8 km" android:textSize="22sp" android:textStyle="bold"
                        android:textColor="@color/text_primary"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Distance" android:textSize="9sp" android:textColor="@color/text_secondary"/>
                </LinearLayout>

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical"
                    android:gravity="center" android:background="@drawable/bg_stat_dark"
                    android:padding="10dp" android:layout_marginEnd="6dp">
                    <TextView android:id="@+id/tvDetailTime"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="~24m" android:textSize="22sp" android:textStyle="bold"
                        android:textColor="#EF9F27"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Est. Time" android:textSize="9sp" android:textColor="@color/text_secondary"/>
                </LinearLayout>

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical"
                    android:gravity="center" android:background="@drawable/bg_stat_dark"
                    android:padding="10dp">
                    <TextView android:id="@+id/tvDetailAutos"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="3" android:textSize="22sp" android:textStyle="bold"
                        android:textColor="#1D9E75"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Autos" android:textSize="9sp" android:textColor="@color/text_secondary"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Stop list card -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Stops on this route"
                android:textSize="11sp" android:textColor="@color/text_secondary"
                android:layout_marginBottom="8dp"/>

            <LinearLayout android:id="@+id/stopListContainer"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:background="@drawable/bg_dark_card"
                android:padding="12dp" android:layout_marginBottom="20dp"/>

            <!-- Start Tracking button -->
            <LinearLayout android:id="@+id/btnStartTracking"
                android:layout_width="match_parent" android:layout_height="56dp"
                android:orientation="horizontal" android:gravity="center"
                android:background="@drawable/bg_stop_btn_active"
                android:layout_marginBottom="8dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="▶  Start Tracking" android:textSize="16sp"
                    android:textStyle="bold" android:textColor="@color/bg_page"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
    <!-- Bottom nav -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="62dp"
        android:orientation="horizontal" android:background="@drawable/bg_bottom_nav"
        android:gravity="center_vertical">
        <LinearLayout android:id="@+id/navHome" android:layout_width="0dp"
            android:layout_height="match_parent" android:layout_weight="1"
            android:orientation="vertical" android:gravity="center">
            <ImageView android:layout_width="22dp" android:layout_height="22dp"
                android:src="@drawable/ic_nav_home_inactive" android:layout_marginBottom="2dp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Home" android:textSize="9sp" android:textColor="@color/text_secondary"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/navTrack" android:layout_width="0dp"
            android:layout_height="match_parent" android:layout_weight="1"
            android:orientation="vertical" android:gravity="center">
            <LinearLayout android:layout_width="44dp" android:layout_height="44dp"
                android:background="@drawable/bg_nav_pill" android:gravity="center">
                <ImageView android:layout_width="22dp" android:layout_height="22dp"
                    android:src="@drawable/ic_nav_auto"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:id="@+id/navHistory" android:layout_width="0dp"
            android:layout_height="match_parent" android:layout_weight="1"
            android:orientation="vertical" android:gravity="center">
            <ImageView android:layout_width="22dp" android:layout_height="22dp"
                android:src="@drawable/ic_nav_stats" android:layout_marginBottom="2dp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="History" android:textSize="9sp" android:textColor="@color/text_secondary"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/navStats" android:layout_width="0dp"
            android:layout_height="match_parent" android:layout_weight="1"
            android:orientation="vertical" android:gravity="center">
            <ImageView android:layout_width="22dp" android:layout_height="22dp"
                android:src="@drawable/ic_nav_stats" android:layout_marginBottom="2dp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Stats" android:textSize="9sp" android:textColor="#1D9E75"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/navProfile" android:layout_width="0dp"
            android:layout_height="match_parent" android:layout_weight="1"
            android:orientation="vertical" android:gravity="center">
            <ImageView android:layout_width="22dp" android:layout_height="22dp"
                android:src="@drawable/ic_nav_about" android:layout_marginBottom="2dp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Profile" android:textSize="9sp" android:textColor="@color/text_secondary"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/navAbout" android:layout_width="0dp"
            android:layout_height="match_parent" android:layout_weight="1"
            android:orientation="vertical" android:gravity="center">
            <ImageView android:layout_width="22dp" android:layout_height="22dp"
                android:src="@drawable/ic_nav_about" android:layout_marginBottom="2dp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="About" android:textSize="9sp" android:textColor="@color/text_secondary"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>