<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/bg_page">

    <!-- Map fills upper half -->
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1">
        <org.osmdroid.views.MapView android:id="@+id/searchMapView"
            android:layout_width="match_parent" android:layout_height="match_parent"/>
        <!-- Pulse ring overlay -->
        <FrameLayout android:layout_width="100dp" android:layout_height="100dp"
            android:layout_gravity="center">
            <View android:id="@+id/pulseRing"
                android:layout_width="100dp" android:layout_height="100dp"
                android:background="@drawable/bg_circle_green" android:alpha="0.4"/>
            <View android:layout_width="22dp" android:layout_height="22dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_circle_green"/>
        </FrameLayout>
    </FrameLayout>

    <!-- Bottom sheet -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:background="@drawable/bg_driver_request_sheet"
        android:paddingStart="16dp" android:paddingEnd="16dp"
        android:paddingTop="16dp" android:paddingBottom="24dp">

        <!-- Phase 1: Searching -->
        <LinearLayout android:id="@+id/phaseSearching"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical">
            <ProgressBar android:id="@+id/searchProgress"
                android:layout_width="match_parent" android:layout_height="4dp"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:progressTint="#1D9E75" android:indeterminate="true"
                android:layout_marginBottom="16dp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Finding a safe driver for you..."
                android:textSize="16sp" android:textStyle="bold" android:textColor="@color/text_primary"
                android:layout_marginBottom="4dp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Checking driver ratings and proximity..."
                android:textSize="12sp" android:textColor="@color/text_secondary"
                android:layout_marginBottom="20dp"/>
            <TextView android:id="@+id/btnCancelSearch"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:text="Cancel" android:textSize="12sp" android:textColor="@color/text_muted"
                android:padding="8dp" android:clickable="true" android:focusable="true"/>
        </LinearLayout>

        <!-- Phase 2: Driver Found — shows driver card + tip selection -->
        <LinearLayout android:id="@+id/phaseDriverFound"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:visibility="gone">

            <!-- Driver Found header -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:layout_marginBottom="12dp">
                <!-- Avatar circle -->
                <FrameLayout android:layout_width="52dp" android:layout_height="52dp"
                    android:background="@drawable/bg_avatar_circle"
                    android:layout_marginEnd="12dp">
                    <TextView android:id="@+id/tvFoundDriverInitial"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="RK" android:textSize="18sp" android:textStyle="bold"
                        android:textColor="#1D9E75"/>
                </FrameLayout>
                <!-- Driver info -->
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Driver Found!" android:textSize="11sp"
                        android:textColor="#1D9E75" android:textAllCaps="true"
                        android:layout_marginBottom="2dp"/>
                    <TextView android:id="@+id/tvFoundDriverName"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Rajan Kumar" android:textSize="15sp"
                        android:textStyle="bold" android:textColor="@color/text_primary"/>
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:layout_marginTop="2dp">
                        <TextView android:id="@+id/tvFoundDriverPlate"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="KA 01 AB 1234" android:textSize="11sp" android:textColor="@color/text_secondary"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text=" · " android:textSize="11sp" android:textColor="@color/text_muted"/>
                        <TextView android:id="@+id/tvFoundDriverRating"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="⭐ 4.8" android:textSize="11sp" android:textColor="#EF9F27"/>
                    </LinearLayout>
                </LinearLayout>
                <!-- ETA chip -->
                <TextView android:id="@+id/tvFoundDriverVehicle"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Auto · ~3 min" android:textSize="10sp" android:textColor="#1D9E75"
                    android:background="@drawable/bg_badge_teal"
                    android:paddingStart="8dp" android:paddingEnd="8dp"
                    android:paddingTop="4dp" android:paddingBottom="4dp"/>
            </LinearLayout>

            <!-- Divider -->
            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="@color/border" android:layout_marginBottom="12dp"/>

            <!-- Tip section -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="ADD A TIP (OPTIONAL)" android:textSize="10sp"
                android:textColor="@color/text_muted" android:letterSpacing="0.1"
                android:layout_marginBottom="8dp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginBottom="14dp">
                <TextView android:id="@+id/tip0"  android:layout_width="0dp" android:layout_height="38dp"
                    android:layout_weight="1" android:gravity="center" android:text="₹0"
                    android:textSize="13sp" android:textColor="#1D9E75"
                    android:background="@drawable/bg_tip_pill_selected"
                    android:layout_marginEnd="6dp" android:clickable="true" android:focusable="true"/>
                <TextView android:id="@+id/tip20" android:layout_width="0dp" android:layout_height="38dp"
                    android:layout_weight="1" android:gravity="center" android:text="₹20"
                    android:textSize="13sp" android:textColor="@color/text_secondary"
                    android:background="@drawable/bg_tip_pill_normal"
                    android:layout_marginEnd="6dp" android:clickable="true" android:focusable="true"/>
                <TextView android:id="@+id/tip30" android:layout_width="0dp" android:layout_height="38dp"
                    android:layout_weight="1" android:gravity="center" android:text="₹30"
                    android:textSize="13sp" android:textColor="@color/text_secondary"
                    android:background="@drawable/bg_tip_pill_normal"
                    android:layout_marginEnd="6dp" android:clickable="true" android:focusable="true"/>
                <TextView android:id="@+id/tip50" android:layout_width="0dp" android:layout_height="38dp"
                    android:layout_weight="1" android:gravity="center" android:text="₹50"
                    android:textSize="13sp" android:textColor="@color/text_secondary"
                    android:background="@drawable/bg_tip_pill_normal"
                    android:clickable="true" android:focusable="true"/>
            </LinearLayout>

            <Button android:id="@+id/btnConfirmTrip"
                android:layout_width="match_parent" android:layout_height="52dp"
                android:text="Confirm Ride →"
                android:textAllCaps="false" android:textSize="15sp" android:textStyle="bold"
                android:textColor="#FFFFFF" android:backgroundTint="#1D9E75"/>
        </LinearLayout>

        <!-- No driver state -->
        <LinearLayout android:id="@+id/phaseNoDriver"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:gravity="center" android:visibility="gone"
            android:paddingTop="16dp" android:paddingBottom="8dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="No drivers available nearby"
                android:textSize="15sp" android:textStyle="bold" android:textColor="@color/text_primary"
                android:layout_marginBottom="12dp"/>
            <Button android:id="@+id/btnTryAgain"
                android:layout_width="wrap_content" android:layout_height="44dp"
                android:text="Try Again" android:textAllCaps="false"
                android:background="@drawable/bg_teal_outline_btn"
                android:textColor="#1D9E75" android:paddingStart="24dp" android:paddingEnd="24dp"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
